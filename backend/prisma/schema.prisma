generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  tenant_admin
}

enum TenantStatus {
  pending_setup
  active
  suspended
}

enum ConversationStatus {
  ai_active
  human_active
  awaiting_human
  resolved
}

enum MessageDirection {
  incoming
  outgoing
}

enum AiUsageCategory {
  text
  vision
  stt
  rag
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  role                UserRole
  isActive            Boolean    @default(true)
  mustChangePassword  Boolean    @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())

  ownedTenant         Tenant?    @relation("TenantOwner")
}

model Tenant {
  id                 String        @id @default(uuid())
  name               String
  status             TenantStatus  @default(pending_setup)
  ownerUserId        String?       @unique
  owner              User?         @relation("TenantOwner", fields: [ownerUserId], references: [id])
  contactEmail       String?
  industry           String?
  timezone           String        @default("Asia/Almaty")
  aiPersona          String        @default("")
  warmupStartedAt    DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?
  createdAt          DateTime      @default(now())

  apiKeys            TenantApiKeys?
  modelChoices       TenantModelChoices?
  whatsappSession    WhatsappSession?
  conversations      Conversation[]
  knowledgeFiles     KnowledgeFile[]
  apiKeyAuditLogs    ApiKeyAuditLog[]
  aiUsageLogs        AiUsageLog[]
}

model TenantApiKeys {
  tenantId        String   @id
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openaiKey       String?  // encrypted
  geminiKey       String?  // encrypted (mandatory for active tenant)
  xaiKey          String?  // encrypted
  elevenlabsKey   String?  // encrypted
  sonioxKey       String?  // encrypted
  geminiCorpusId  String?  // Gemini File Search corpus
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

model ApiKeyAuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  field       String   // 'openaiKey' | 'geminiKey' | etc.
  action      String   // 'set' | 'updated' | 'cleared' | 'revealed'
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

model TenantModelChoices {
  tenantId        String   @id
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  textModelId     String   @default("gemini-3-flash")
  visionModelId   String   @default("gemini-3-flash")
  sttModelId      String   @default("elevenlabs-scribe-v2")
  updatedAt       DateTime @updatedAt
}

model WhatsappSession {
  tenantId              String    @id
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encryptedCreds        String?   // AES-GCM encrypted JSON of creds
  encryptedKeys         String?   // AES-GCM encrypted JSON of keys store
  phoneNumber           String?
  lastDisconnectReason  String?
  lastConnectedAt       DateTime?
  status                String    @default("disconnected") // disconnected | connecting | qr | connected
  dailySendCount        Int       @default(0)
  dayWindowStartedAt    DateTime?
  hourlySendCount       Int       @default(0)
  hourWindowStartedAt   DateTime?
  updatedAt             DateTime  @updatedAt
}

model KnowledgeFile {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filename          String
  fileSizeBytes     Int
  mimeType          String?
  geminiFileId      String?
  geminiCorpusId    String?
  uploadedById      String?
  createdAt         DateTime @default(now())

  @@index([tenantId])
}

model Conversation {
  id                       String              @id @default(uuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactIdentifier        String              // WhatsApp JID
  contactName              String?
  status                   ConversationStatus  @default(ai_active)
  assignedOperatorId       String?
  lastHumanActivityAt      DateTime?
  handoffReason            String?
  lastMessageAt            DateTime            @default(now())
  unreadCount              Int                 @default(0)
  createdAt                DateTime            @default(now())

  messages                 Message[]

  @@unique([tenantId, contactIdentifier])
  @@index([tenantId, status, lastMessageAt])
}

model Message {
  id                String            @id @default(uuid())
  conversationId    String
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId          String
  direction         MessageDirection
  sentBy            String            // 'ai' | 'customer' | <user_id>
  content           String?           @db.Text
  mediaUrl          String?
  mediaType         String?           // image | audio | document
  transcribedText   String?           @db.Text
  aiConfidence      Float?
  whatsappMsgId     String?
  createdAt         DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

model AiUsageLog {
  id                  String           @id @default(uuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            AiUsageCategory
  provider            String
  modelId             String
  inputTokens         Int              @default(0)
  outputTokens        Int              @default(0)
  durationSeconds     Float?
  estimatedCostUsd    Float            @default(0)
  conversationId      String?
  createdAt           DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, category, createdAt])
}
