# Auto-injected by Railway in production
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_platform
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development

# Manual — generate with openssl
# openssl rand -hex 64
JWT_SECRET=replace_me_with_64_byte_hex
# openssl rand -hex 32 (EXACTLY 32 bytes)
ENCRYPTION_KEY=replace_me_with_32_byte_hex

# Bootstrap super admin (used only on first start, remove after)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me_immediately

# Public URL of the deployment
APP_URL=http://localhost:3000
