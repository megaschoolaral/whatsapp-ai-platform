# ============================================================
# Backend environment variables
# Copy this file to `.env` and fill in real values.
# In Railway, set these in the project's Variables tab instead.
# ============================================================

# --- Auto-injected by Railway in production ---
# Locally: point at your own Postgres + Redis.
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_platform
REDIS_URL=redis://localhost:6379
PORT=3000

NODE_ENV=development

# --- Required secrets — generate fresh, never reuse ---
# 64 hex chars (32 bytes). Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_64

# EXACTLY 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# CRITICAL: back this up. Losing it bricks all encrypted tenant API keys.
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# --- Bootstrap super-admin (used only on first start) ---
# Password must be >=12 chars and NOT a placeholder
# (the app refuses to create the admin if it's "change_me_immediately",
# "password", "admin", "changeme", or shorter than 12 chars).
# Remove SUPER_ADMIN_PASSWORD from Railway after first login.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_12CHARS_MIN

# --- Public URL of the deployment ---
# Local: http://localhost:3000
# Railway: https://YOUR-APP.up.railway.app (must match the real domain —
# in production this is used for CORS and Socket.IO origin checks).
APP_URL=http://localhost:3000
